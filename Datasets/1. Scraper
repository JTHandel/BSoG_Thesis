is_navigation_page <- function(url, title, txt) {
  url_l   <- str_to_lower(url   %||% "")
  title_l <- str_to_lower(title %||% "")
  txt_l   <- str_to_lower(txt   %||% "")
  
  url_bad <- str_detect(url_l, paste(c(
    "/en/policies$",
    "/en/library$",
    "/en/news$",
    "/en/events$",
    "/en/funding$",
    "/en/activities$",
    "/en/consultations$",
    "/en/newsletters$",
    "related-content\\?topic=",
    "/en/activities/digital-programme$"
  ), collapse = "|"))
  
  title_bad <- str_detect(title_l, paste(c(
    "^policies(\\s*[|\\-].*)?$",
    "^library(\\s*[|\\-].*)?$",
    "^news(\\s*[|\\-].*)?$",
    "^events(\\s*[|\\-].*)?$",
    "^funding(\\s*[|\\-].*)?$",
    "^activities(\\s*[|\\-].*)?$",
    "^consultations(\\s*[|\\-].*)?$",
    "^subscribe to the news",
    "^browse artificial intelligence",
    "^skip to main content",
    "^more$",
    "^digital europe(\\s*[|\\-].*)?$"
  ), collapse = "|"))
  
  text_bad <- nchar(txt_l) < 3000 &&
    str_detect(txt_l, "filter by|sort by|search results|showing \\d+ results")
  
  url_bad | title_bad | text_bad
}

is_non_english_url <- function(url) {
  if (is.na(url)) return(FALSE)
  url_l  <- str_to_lower(url)
  langs  <- "bg|es|cs|da|de|et|el|fr|ga|hr|it|lv|lt|hu|mt|nl|pl|pt|ro|sk|sl|fi|sv"
  str_detect(url_l, paste0("/(", langs, ")/")) |
    str_detect(url_l, paste0("[?&]from=(", langs, ")($|&)")) |
    str_detect(url_l, paste0("[?&]locale=(", langs, ")($|&)")) |
    str_detect(url_l, paste0("[?&]lang=(", langs, ")($|&)"))
}

is_junk_title <- function(title) {
  if (is.na(title)) return(TRUE)
  t <- str_squish(title)
  str_detect(t, paste(c(
    "^(LT|ET|CS|LV|PL|HR|SK|SL|BG|RO|HU|MT|GA|DA|FI|SV|NL|PT|ES|DE|FR|IT|EL)[A-Z]",
    "^https?://",
    "^[a-z]{2}$",
    "^\\d+$"
  ), collapse = "|"))
}

