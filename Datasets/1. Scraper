#Functions

`%||%` <- function(x, y) if (is.null(x) || length(x) == 0 || is.na(x)[1]) y else x
make_hash  <- function(x) digest(x, algo = "xxhash64")
sleep_polite <- function(s = REQUEST_SLEEP_SEC) Sys.sleep(s)

is_pdf_file <- function(path) {
  if (is.na(path) || !file.exists(path)) return(FALSE)
  con <- file(path, "rb")
  on.exit(close(con), add = TRUE)
  sig <- tryCatch(
    readChar(con, nchars = 4, useBytes = TRUE),
    error = function(e) NA_character_
  )
  identical(sig, "%PDF")
}

sha256_file <- function(path) {
  if (is.na(path) || !file.exists(path)) return(NA_character_)
  tryCatch(digest(file = path, algo = "sha256"), error = function(e) NA_character_)
}


append_manifest <- function(row_df, manifest_path = MANIFEST_CSV) {
  if (!file.exists(manifest_path)) {
    write_csv(row_df, manifest_path)
    return(invisible(NULL))
  }
  existing <- tryCatch(
    read_csv(manifest_path, show_col_types = FALSE),
    error = function(e) tibble(url = character())
  )
  already_logged <- row_df$url %in% existing$url[existing$status %in% c("ok", "cached")]
  if (!already_logged) {
    suppressWarnings(write_csv(row_df, manifest_path, append = TRUE))
  }
}

log_download <- function(url, local_path, status, note = NA_character_) {
  row <- tibble(
    retrieved_at = as.character(Sys.time()),
    url          = url,
    local_path   = local_path %||% NA_character_,
    status       = status,
    file_size    = if (!is.na(local_path) && file.exists(local_path))
      file.size(local_path) else NA_real_,
    sha256       = sha256_file(local_path),
    note         = note
  )
  append_manifest(row)
}

