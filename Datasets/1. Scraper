# Minimum length depends on doc_type — short press releases get lower threshold
min_chars_for_doc <- function(dt) {
  dt <- str_to_lower(dt %||% "")
  if (str_detect(dt, "press release|statement|announcement|tweet")) return(200L)
  if (str_detect(dt, "report|opinion|regulation|directive|decision|communication")) return(600L)
  MIN_CHARS_DEFAULT
}

extracted <- extracted |>
  mutate(
    latin       = map_dbl(text_readable, latin_share),
    trans_notice = map_lgl(text_readable, has_translation_notice),
    nav_page    = pmap_lgl(
      list(url, title, text_readable),
      function(u, t, x) is_navigation_page(u, t, x)
    ),
    non_eng_url = map_lgl(url, is_non_english_url),
    min_chars   = map_int(doc_type, min_chars_for_doc),
    
    exclusion_reason = case_when(
      !file_exists                               ~ "download_missing",
      is.na(file_size) | file_size <= 0         ~ "empty_file",
      non_eng_url                                ~ "non_english_url",
      map_lgl(title, is_junk_title)             ~ "junk_title",
       is.na(text_raw)                            ~ "extraction_failed",
      !text_ok                                   ~ "low_quality_text",
      is.na(text_readable)                       ~ "readable_missing",
      nchar_readable < min_chars                 ~ "too_short_after_cleaning",
      trans_notice                               ~ "machine_translation",
      !is.na(latin) & latin < MIN_LATIN_SHARE   ~ "likely_non_english",
      nav_page                                   ~ "navigation_or_listing_page",
      TRUE                                       ~ NA_character_
    ),
    is_excluded = !is.na(exclusion_reason)
  )

message("Exclusion summary:")
print(extracted |> count(exclusion_reason, sort = TRUE))

# Dedups

extracted <- extracted |>
  mutate(
    hash_exact = map_chr(text_model,
                         ~ if (is.na(.x)) NA_character_ else make_hash(.x)),
    hash_canon = map_chr(text_model,
                         ~ if (is.na(.x)) NA_character_ else make_hash(str_squish(str_to_lower(.x))))
  )

dup_report <- extracted |>
  filter(!is_excluded) |>
  count(hash_canon, name = "dup_count") |>
  filter(dup_count > 1, !is.na(hash_canon))
write_csv(dup_report, DEDUP_CSV)
message("Duplicate groups found: ", nrow(dup_report))

docs_dedup <- extracted |>
  arrange(doc_id) |>
  mutate(dedup_key = if_else(
    is.na(hash_canon),
    paste0("no_hash:", doc_id),
    hash_canon
  )) |>
  group_by(dedup_key) |>
  slice(1) |>
  ungroup() |>
  select(-dedup_key)



metadata <- docs_dedup |>
  transmute(
    doc_id, canonical_id, source, url, celex,
    title       = coalesce(.data$title, canonical_id),
    date        = suppressWarnings(as.Date(.data$date)),
    year        = if_else(!is.na(date), year(date), NA_integer_),
    institution = coalesce(.data$institution, "Unknown"),
    doc_type    = coalesce(.data$doc_type,    "Unknown"),
    language    = coalesce(.data$language,    "EN"),
    kind, local_path, file_exists, is_pdf, file_ext, file_size,
    n_pages, alpha, latin, trans_notice, nav_page, text_ok, non_eng_url,
    nchar_raw, nchar_readable, nchar_model,
    hash_exact, hash_canon,
    exclusion_reason, is_excluded
  )

documents_long <- docs_dedup |>
  select(doc_id, text_raw, text_clean, text_readable, text_model)

write_csv(metadata,  METADATA_CSV)
saveRDS(metadata,    METADATA_RDS)
saveRDS(documents_long, DOCUMENTS_RDS)

message("\nDONE")
message("Total documents:  ", nrow(metadata))
message("Usable documents: ", sum(!metadata$is_excluded, na.rm = TRUE))
message("Excluded:         ", sum(metadata$is_excluded,  na.rm = TRUE))

print(metadata |> summarise(
  n_total    = n(),
  n_usable   = sum(!is_excluded, na.rm = TRUE),
  n_pdf      = sum(is_pdf,       na.rm = TRUE),
  n_excluded = sum(is_excluded,  na.rm = TRUE),
