guess_ext_from_url <- function(url) {
  path_part <- sub("^https?://[^/]+", "", url)
  path_part <- sub("\\?.*$", "", path_part)
  ext <- tolower(tools::file_ext(path_part))
  if (is.na(ext) || ext == "") return(NA_character_)
  ext
}

guess_ext_from_ct <- function(ct) {
  ct <- tolower(ct %||% "")
  if (str_detect(ct, "pdf"))  return("pdf")
  if (str_detect(ct, "html")) return("html")
  if (str_detect(ct, "json")) return("json")
  "bin"
}

safe_download <- function(url, destfile) {
  ok        <- FALSE
  last_note <- NA_character_
  
  for (i in seq_len(MAX_RETRIES)) {
    resp <- tryCatch(
      httr::GET(
        url,
        httr::user_agent(ua_string),
        httr::timeout(60),
        httr::write_disk(destfile, overwrite = TRUE)
      ),
      error = function(e) e
    )
    
    if (inherits(resp, "error")) {
      last_note <- paste("GET_error:", resp$message)
    } else {
      sc <- httr::status_code(resp)
      if (sc >= 200 && sc < 300 &&
          file.exists(destfile) && file.size(destfile) > 0) {
        ok        <- TRUE
        last_note <- paste("http", sc)
        break
      } else {
        last_note <- paste("http", sc)
      }
    }
    Sys.sleep(RETRY_BACKOFF_SEC * i)
  }
  list(ok = ok, note = last_note)
}

download_cached <- function(url, dest_dir = DIR_RAW, force_ext = NULL) {
  url_hash <- make_hash(url)
  ext      <- force_ext %||% guess_ext_from_url(url)
  if (is.null(ext) || is.na(ext) || ext == "") {
    head_resp <- tryCatch(
      httr::HEAD(url, httr::user_agent(ua_string), httr::timeout(20)),
      error = function(e) NULL
    )
    ct  <- if (!is.null(head_resp)) httr::headers(head_resp)[["content-type"]] else NA
    ext <- guess_ext_from_ct(ct)
  }
  
  path <- file.path(dest_dir, paste0(url_hash, ".", ext))
  
  if (file.exists(path) && file.size(path) > 0) {
    log_download(url, path, "cached", "already_downloaded")
    return(path)
  }
  
  res <- safe_download(url, path)
  sleep_polite()
  
  if (!isTRUE(res$ok)) {
    log_download(url, NA_character_, "fail", res$note)
    return(NA_character_)
  }
  log_download(url, path, "ok", res$note)
  path
}

download_eurlex <- function(celex, dest_dir = DIR_RAW) {
  
  try_pdf <- function(url) {
    path <- download_cached(url, dest_dir = dest_dir, force_ext = "pdf")
    if (!is.na(path) && is_pdf_file(path)) return(path)
    # If downloaded file is not a real PDF, delete it so it doesn't pollute cache
    if (!is.na(path) && file.exists(path)) file_delete(path)
    NA_character_
  }

  p <- try_pdf(paste0(
    "https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:", celex
  ))
  if (!is.na(p)) return(p)
  
  p <- try_pdf(paste0(
    "https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:", celex,
    "&from=EN"
  ))
  if (!is.na(p)) return(p)

  html_url  <- paste0(
    "https://eur-lex.europa.eu/legal-content/EN/ALL/?uri=CELEX:", celex
  )
  html_path <- download_cached(html_url, dest_dir = dest_dir, force_ext = "html")
  if (!is.na(html_path)) {
    html_doc <- tryCatch(xml2::read_html(html_path), error = function(e) NULL)
    if (!is.null(html_doc)) {
      hrefs <- html_doc |>
        rvest::html_elements("a") |>
        rvest::html_attr("href") |>
        na.omit() |>
        unique()
      hrefs <- xml2::url_absolute(hrefs, html_url)
      pdf_links <- hrefs[str_detect(hrefs, "(?i)\\.pdf(\\?|$)|/TXT/PDF/")]
      for (u in pdf_links) {
        p <- try_pdf(u)
        if (!is.na(p)) return(p)
        sleep_polite(0.3)
      }
    }
    return(html_path)
  }

  html_url2 <- paste0(
    "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:", celex
  )
  html_path2 <- download_cached(html_url2, dest_dir = dest_dir, force_ext = "html")
  if (!is.na(html_path2)) return(html_path2)
  
  NA_character_
}

#Text extract

page_lines <- function(page_text) {
  lines <- unlist(str_split(str_replace_all(page_text, "\r", "\n"), "\n"))
  lines[str_squish(lines) != ""]
}

remove_repeated_lines <- function(pages, frac = DEHEADER_FRAC) {
  if (length(pages) == 0) return(pages)
  per_page <- lapply(pages, function(p) unique(page_lines(p)))
  freq      <- table(unlist(per_page))
  threshold <- ceiling(length(pages) * frac)
  drop      <- names(freq[freq >= threshold])
  lapply(per_page, function(lines) paste(lines[!lines %in% drop], collapse = "\n"))
}

extract_pdf <- function(path) {
  pages <- tryCatch(pdftools::pdf_text(path), error = function(e) NULL)
  if (is.null(pages)) return(list(
    text_raw = NA_character_, text_clean = NA_character_,
    n_pages = NA_integer_, ok = FALSE
  ))
  text_raw   <- paste(pages, collapse = "\n\n")
  text_clean <- paste(remove_repeated_lines(pages), collapse = "\n\n")
  list(
    text_raw   = text_raw,
    text_clean = text_clean,
    n_pages    = length(pages),
    ok         = nchar(text_raw) >= 500 &&
      (str_count(text_raw, "[A-Za-z]") / nchar(text_raw)) >= MIN_ALPHA_SHARE
  )
}

extract_html <- function(path) {
  doc <- tryCatch(xml2::read_html(path, encoding = "UTF-8"), error = function(e) NULL)
  if (is.null(doc)) return(NA_character_)
  
  boilerplate <- xml2::xml_find_all(
    doc,
    paste(
      ".//script", ".//style", ".//noscript",
      ".//header", ".//footer", ".//nav",
      ".//form", ".//aside",
      "//*[@id='cookie-consent-banner']",
      "//*[contains(@class,'language-selector')]",
      "//*[contains(@class,'site-header')]",
      "//*[contains(@class,'site-footer')]",
      sep = " | "
    )
  )
  if (length(boilerplate) > 0) xml2::xml_remove(boilerplate)
  
  main <- xml2::xml_find_first(doc, paste(
    "//*[@id='MainContent']",
    "//*[@id='main-content']",
    "//*[@id='content']",
    "//*[@role='main']",
    "//main",
    "//article",
    "//*[contains(@class,'tex-normal')]",      # EUR-Lex
    "//*[contains(@class,'doc-content')]",     # EUR-Lex alternative
    "//*[contains(@class,'col-lg-9')]",        # EC digital strategy
    "//*[contains(@class,'item-page')]",       # ENISA
    "//*[contains(@class,'ep-a_content')]",    # European Parliament
    "//*[contains(@class,'policy-page')]",     # Council
    "//body",
    sep = " | "
  ))
  
  if (is.na(main)) return(NA_character_)
  txt <- xml2::xml_text(main)
  if (is.na(txt) || str_squish(txt) == "") return(NA_character_)
  txt
}


clean_readable <- function(x) {
  if (is.na(x)) return(NA_character_)
  x <- str_replace_all(x, "[\u00A0\u2007\u202F]", " ")
  x <- str_replace_all(x, "\r", "\n")
  x <- str_replace_all(x, "(?im)^\\s*page\\s*\\d+\\s*(of\\s*\\d+)?\\s*$", "")
  x <- str_replace_all(x, "(?im)^\\s*\\d+\\s*/\\s*\\d+\\s*$", "")
  x <- str_replace_all(x, "(?im)^\\s*EN\\s*$", "")
  x <- str_replace_all(x, "(?i)skip to main content", " ")
  x <- str_replace_all(x, "(?i)select your language.*?search", " ")
  x <- str_replace_all(x, "[ \t]+", " ")
  x <- str_replace_all(x, "\n{3,}", "\n\n")
  str_trim(x)
}

clean_model <- function(x) {
  if (is.na(x)) return(NA_character_)
  x <- clean_readable(x)
  x <- str_to_lower(x)
  x <- str_replace_all(x, "https?://\\S+", " ")
  x <- str_replace_all(x, "\\b\\S+@\\S+\\b", " ")
  x <- str_replace_all(x, "[^a-z\\s]", " ")
  str_squish(x)
}


alpha_share <- function(txt) {
  if (is.na(txt) || nchar(txt) == 0) return(NA_real_)
  str_count(txt, "[A-Za-z]") / nchar(txt)
}

latin_share <- function(txt) {
  if (is.na(txt) || nchar(txt) == 0) return(NA_real_)
  str_count(txt, "[A-Za-z]") / nchar(txt)
}

