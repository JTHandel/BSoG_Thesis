fix_csv_quoting <- function(filepath) {
  raw_lines <- readLines(filepath, warn = FALSE)
  fixed <- map_chr(raw_lines, function(line) {
    if (str_detect(line, '^".*"$') && str_count(line, '""') > 0) {
      line <- str_sub(line, 2, -2)
      line <- str_replace_all(line, '""', '"')
    }
    line
  })
  writeLines(fixed, filepath)
}

