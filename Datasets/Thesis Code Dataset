ua_string <- "BSoG_Thesis_AIactionplan_Scraper/1.0 (academic; contact: veco.Julian.Ter.Hedde@vub.be)"

safe_req <- function(url) {                           
  request(url) |>                                          
    req_user_agent(ua_string) |>                            
    req_timeout(60) |>                                      
    req_retry(                                              
      max_tries = 5,                                        
      backoff = ~ 2^(.x - 1)                                
    )
}

make_doc_id <- function(url) digest(url, algo = "xxhash64")

sleep_polite <- function(seconds = 0.5) Sys.sleep(seconds)

download_file_cached <- function(url, dest_dir = DIR_RAW) {
  doc_id <- make_doc_id(url)
  ext <- tolower(tools::file_ext(urltools::url_parse(url)$path))
  if (ext == "") ext <- "bin"
  path <- file.path(dest_dir, paste0(doc_id, ".", ext))
  if (!file.exists(path)) {
    resp <- safe_req(url) |> req_perform()
    writeBin(resp_body_raw(resp), path)
    sleep_polite(0.4)
  }
  return(path)
}

clean_light <- function(x) {                                                 
  x |>
    str_replace_all("\\s+", " ") |>                                          
    str_squish()                                                             
}
