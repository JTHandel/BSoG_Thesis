celex_tbl <- readr::read_csv(CELEX_CSV, show_col_types = FALSE) |>
  janitor::clean_names()

if (!"celex" %in% names(celex_tbl)) stop("celex_list.csv must contain a column named 'celex'.")

celex_tbl <- celex_tbl |>
  mutate(
    celex = str_trim(celex),
    url_pdf = paste0("https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:", celex),
    url_html = paste0("https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:", celex)
  )


message("Downloading PDFs (safe EUR-Lex method)...")

downloads <- celex_tbl |>
  mutate(
    pdf_path = map_chr(celex, ~ download_eurlex_pdf(.x, dest_dir = DIR_RAW)),
    pdf_ok   = map_lgl(pdf_path, ~ !is.na(.x) && is_pdf_file(.x)),
    pdf_size = if_else(pdf_ok, file_info(pdf_path)$size, NA_real_)
  )


message("Extracting and cleaning text...")

docs_long <- downloads |>
  mutate(
    doc_id = map_chr(celex, make_doc_id),
    text_raw = map_chr(pdf_path, ~ if (!is.na(.x) && file.exists(.x)) extract_pdf_text(.x) else NA_character_),
    text_clean = map_chr(text_raw, clean_text_eu),
    nchar_raw = if_else(is.na(text_raw), NA_integer_, nchar(text_raw)),
    nchar_clean = if_else(is.na(text_clean), NA_integer_, nchar(text_clean))
  )


MIN_CHARS <- 500
docs_long <- docs_long |>
  mutate(is_too_short = is.na(text_clean) | nchar_clean < MIN_CHARS)

message("Too short after cleaning: ", sum(docs_long$is_too_short, na.rm = TRUE), " / ", nrow(docs_long))


docs_long <- docs_long |>
  mutate(hash_clean = map_chr(text_clean, ~ ifelse(is.na(.x), NA_character_, digest(.x, algo = "xxhash64"))))

dedup_report <- docs_long |>
  count(hash_clean, sort = TRUE, name = "dup_count") |>
  filter(!is.na(hash_clean) & dup_count > 1)

write_csv(dedup_report, file.path(DIR_OUT, "dedup_report.csv"))

docs_dedup <- docs_long |>
  arrange(doc_id) |>
  group_by(hash_clean) |>
  slice(1) |>
  ungroup()


