make_doc_id <- function(x) digest(x, algo = "xxhash64")
sleep_polite <- function(seconds = 0.4) Sys.sleep(seconds)

download_file_cached <- function(url, dest_dir = DIR_RAW) {
  doc_id <- make_doc_id(url)
  
  path_part <- sub("^https?://[^/]+", "", url)
  path_part <- sub("\\?.*$", "", path_part)
  ext <- tolower(tools::file_ext(path_part))
  if (is.na(ext) || ext == "") ext <- "pdf"
  
  path <- file.path(dest_dir, paste0(doc_id, ".", ext))
  
  if (!file.exists(path)) {
    suppressWarnings(
      utils::download.file(url, destfile = path, mode = "wb", quiet = TRUE)
    )
    sleep_polite(0.4)
  }
  
  path
}

is_pdf_file <- function(path) {
  if (!file.exists(path)) return(FALSE)
  con <- file(path, "rb")
  on.exit(close(con), add = TRUE)
  sig <- readChar(con, nchars = 4, useBytes = TRUE)
  identical(sig, "%PDF")
}

download_eurlex_pdf <- function(celex, dest_dir = DIR_RAW) {
  
  try_download_and_check <- function(url) {
    path <- download_file_cached(url, dest_dir = dest_dir)
    if (is_pdf_file(path)) return(path)
    NA_character_
  }
  
  url_pdf <- paste0("https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:", celex)
  p1 <- try_download_and_check(url_pdf)
  if (!is.na(p1)) return(p1)
  
  url_html <- paste0("https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:", celex)
  html_path <- download_file_cached(url_html, dest_dir = dest_dir)
  
  html_doc <- tryCatch(xml2::read_html(html_path), error = function(e) NULL)
  if (is.null(html_doc)) return(NA_character_)
  
  hrefs <- html_doc |>
    rvest::html_elements("a") |>
    rvest::html_attr("href") |>
    unique()
  
  hrefs <- hrefs[!is.na(hrefs) & nzchar(hrefs)]
  hrefs <- xml2::url_absolute(hrefs, url_html)
  
  candidates <- hrefs[
    stringr::str_detect(hrefs, "(?i)\\.pdf(\\?.*)?$|/TXT/PDF/")
  ]
  
  candidates <- unique(c(
    candidates,
    paste0("https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:", celex, "&from=EN"),
    paste0("https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:", celex, "&qid=", as.integer(Sys.time()))
  ))
  
  for (u in candidates) {
    p <- try_download_and_check(u)
    if (!is.na(p)) return(p)
    sleep_polite(0.3)
  }
  
  NA_character_
}


clean_text_eu <- function(x) {
  if (is.na(x)) return(NA_character_)
  x <- str_replace_all(x, "\r", "\n")
  x <- str_replace_all(x, "[\u00A0\u2007\u202F]", " ")
  x <- str_replace_all(x, "(?im)^\\s*page\\s*\\d+\\s*(of\\s*\\d+)?\\s*$", "")
  x <- str_replace_all(x, "(?im)^\\s*EN\\s*$", "")
  x <- str_replace_all(x, "\\s+", " ")
  x <- str_to_lower(x)
  str_squish(x)
}

extract_pdf_text <- function(pdf_path) {
  pages <- tryCatch(pdftools::pdf_text(pdf_path), error = function(e) NULL)
  if (is.null(pages)) return(NA_character_)
  paste(pages, collapse = "\n")
}


