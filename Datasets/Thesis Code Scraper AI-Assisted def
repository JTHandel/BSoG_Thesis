`%||%` <- function(x, y) if (is.null(x) || length(x) == 0 || is.na(x)[1]) y else x
make_hash <- function(x) digest(x, algo = "xxhash64")
sleep_polite <- function(seconds = REQUEST_SLEEP_SEC) Sys.sleep(seconds)

is_pdf_file <- function(path) {
  if (is.na(path) || !file.exists(path)) return(FALSE)
  con <- file(path, "rb")
  on.exit(close(con), add = TRUE)
  sig <- tryCatch(readChar(con, nchars = 4, useBytes = TRUE), error = function(e) NA_character_)
  identical(sig, "%PDF")
}

sha256_file <- function(path) {
  if (is.na(path) || !file.exists(path)) return(NA_character_)
  tryCatch(digest(file = path, algo = "sha256"), error = function(e) NA_character_)
}

append_manifest <- function(row_df, manifest_path = MANIFEST_CSV) {
