  }
}

log_download_attempt <- function(url, local_path, status, note = NA_character_) {
  row <- tibble(
    retrieved_at = as.character(Sys.time()),
    url = url,
    local_path = local_path %||% NA_character_,
    status = status,
    file_size = if (!is.na(local_path) && file.exists(local_path)) file.size(local_path) else NA_real_,
    sha256 = sha256_file(local_path),
    note = note
  )
  append_manifest(row, MANIFEST_CSV)
}

guess_ext_from_headers <- function(h) {

  ct <- tolower(h[["content-type"]] %||% "")
  if (str_detect(ct, "pdf")) return("pdf")
  if (str_detect(ct, "html")) return("html")
  if (str_detect(ct, "json")) return("json")
  "bin"
}

guess_ext_from_url <- function(url) {
  path_part <- sub("^https?://[^/]+", "", url)
  path_part <- sub("\\?.*$", "", path_part)
  ext <- tolower(tools::file_ext(path_part))
  if (is.na(ext) || ext == "") return(NA_character_)
  ext
}

get_content_type <- function(url) {
  resp <- tryCatch(
    httr::HEAD(url, httr::user_agent(ua_string), httr::timeout(30)),
    error = function(e) NULL
  )
  if (is.null(resp)) return(list(ok = FALSE, content_type = NA_character_))
  ct <- httr::headers(resp)[["content-type"]] %||% NA_character_
  list(ok = TRUE, content_type = ct)
}

safe_download_httr <- function(url, destfile) {
  ok <- FALSE
  last_note <- NA_character_
  
  for (i in seq_len(MAX_RETRIES)) {
    resp <- tryCatch(
      httr::GET(
        url,
        httr::user_agent(ua_string),
        httr::timeout(60),
        httr::write_disk(destfile, overwrite = TRUE)
      ),
      error = function(e) e
    )
    
    if (inherits(resp, "error")) {
      last_note <- paste("GET_error:", resp$message)
    } else {
      sc <- httr::status_code(resp)
      if (!is.na(sc) && sc >= 200 && sc < 300 && file.exists(destfile) && file.size(destfile) > 0) {
        ok <- TRUE
        last_note <- paste("http", sc)
        break
      } else {
        last_note <- paste("http", sc)
      }
    }
    
    Sys.sleep(RETRY_BACKOFF_SEC * i)
  }
  
  list(ok = ok, note = last_note)
}

download_url_cached <- function(url, dest_dir = DIR_RAW, force_ext = NULL) {
  url_hash <- make_hash(url)
  
  ext <- force_ext %||% guess_ext_from_url(url)
  if (is.null(ext) || is.na(ext) || ext == "") {
    
    ct <- get_content_type(url)
    if (isTRUE(ct$ok)) {
      ext <- guess_ext_from_headers(list(`content-type` = ct$content_type))
    } else {
      ext <- "bin"
    }
  }
  
  path <- file.path(dest_dir, paste0(url_hash, ".", ext))
  if (!file.exists(path)) {
    res <- safe_download_httr(url, path)
    sleep_polite()
    if (!isTRUE(res$ok)) {
      log_download_attempt(url, NA_character_, "fail", res$note %||% "download_failed")
      return(NA_character_)
    }
    log_download_attempt(url, path, "ok", res$note %||% "download_ok")
  } else {
    log_download_attempt(url, path, "cached", "already_downloaded")
  }
  
  path
}

download_eurlex_pdf <- function(celex, dest_dir = DIR_RAW) {
  try_pdf <- function(url) {
    path <- download_url_cached(url, dest_dir = dest_dir, force_ext = "pdf")
    if (!is.na(path) && is_pdf_file(path)) return(path)
    NA_character_
  }
  
  url_pdf <- paste0("https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:", celex)
  p1 <- try_pdf(url_pdf)
  if (!is.na(p1)) return(p1)
  
  url_html <- paste0("https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:", celex)
  html_path <- download_url_cached(url_html, dest_dir = dest_dir, force_ext = "html")
  if (is.na(html_path)) return(NA_character_)
  
  html_doc <- tryCatch(xml2::read_html(html_path), error = function(e) NULL)
  if (is.null(html_doc)) return(NA_character_)
  
  hrefs <- html_doc |>
    rvest::html_elements("a") |>
    rvest::html_attr("href") |>
    unique()
  
  hrefs <- hrefs[!is.na(hrefs) & nzchar(hrefs)]
  hrefs <- xml2::url_absolute(hrefs, url_html)
  
  candidates <- hrefs[str_detect(hrefs, "(?i)\\.pdf(\\?.*)?$|/TXT/PDF/")]
  candidates <- unique(c(
    candidates,
    paste0("https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:", celex, "&from=EN")
  ))
  
  for (u in candidates) {
    p <- try_pdf(u)
    if (!is.na(p)) return(p)
    sleep_polite(0.25)
  }
  
  NA_character_
}

page_lines <- function(page_text) {
  page_text <- str_replace_all(page_text, "\r", "\n")
  lines <- unlist(str_split(page_text, "\n"))
  lines <- str_squish(lines)
  lines[lines != ""]
}

remove_repeated_lines_across_pages <- function(pages, repeat_frac = DEHEADER_REPEAT_FRAC) {
  if (is.null(pages) || length(pages) == 0) return(pages)
  
  per_page_unique <- lapply(pages, function(p) unique(page_lines(p)))
  line_freq <- table(unlist(per_page_unique))
  threshold <- ceiling(length(pages) * repeat_frac)
  drop_lines <- names(line_freq[line_freq >= threshold])
  
  cleaned_pages <- lapply(per_page_unique, function(lines) {
    lines <- lines[!lines %in% drop_lines]
    paste(lines, collapse = "\n")
  })
  
  cleaned_pages
}

compute_alpha_share <- function(txt) {
  if (is.na(txt) || nchar(txt) == 0) return(NA_real_)
  letters_n <- str_count(txt, "[A-Za-z]")
  letters_n / nchar(txt)
}

extract_pdf_bundle <- function(pdf_path, repeat_frac = DEHEADER_REPEAT_FRAC) {
  pages <- tryCatch(pdftools::pdf_text(pdf_path), error = function(e) NULL)
  if (is.null(pages)) {
    return(list(text_raw = NA_character_, text_deheader = NA_character_,
                n_pages = NA_integer_, alpha_share = NA_real_, text_ok = FALSE))
  }
  
  text_raw <- paste(pages, collapse = "\n\n")
  cleaned_pages <- remove_repeated_lines_across_pages(pages, repeat_frac = repeat_frac)
  text_deheader <- paste(cleaned_pages, collapse = "\n\n")
  
  alpha_share <- compute_alpha_share(text_raw)
  text_ok <- !is.na(alpha_share) && alpha_share >= MIN_ALPHA_SHARE && nchar(text_raw) >= MIN_RAW_CHARS
  
  list(
    text_raw = text_raw,
    text_deheader = text_deheader,
    n_pages = length(pages),
    alpha_share = alpha_share,
    text_ok = text_ok
  )
}

extract_html_text <- function(html_path) {
  doc <- tryCatch(xml2::read_html(html_path), error = function(e) NULL)
  if (is.null(doc)) return(NA_character_)
  
  nodes <- xml2::xml_find_all(doc, ".//script|.//style|.//noscript")
  if (length(nodes) > 0) xml2::xml_remove(nodes)

  txt <- tryCatch(xml2::xml_text(doc), error = function(e) NA_character_)
  txt
}

clean_text_readable <- function(x) {
  if (is.na(x)) return(NA_character_)
  x <- str_replace_all(x, "[\u00A0\u2007\u202F]", " ")
  x <- str_replace_all(x, "\r", "\n")
  
  x <- str_replace_all(x, "(?im)^\\s*page\\s*\\d+\\s*(of\\s*\\d+)?\\s*$", "")
  x <- str_replace_all(x, "(?im)^\\s*\\d+\\s*/\\s*\\d+\\s*$", "")
  x <- str_replace_all(x, "(?im)^\\s*EN\\s*$", "")

  x <- str_replace_all(x, "[ \t]+", " ")
  x <- str_replace_all(x, "\n{3,}", "\n\n")
  str_trim(x)
}

clean_text_model <- function(x) {
  if (is.na(x)) return(NA_character_)
  x <- clean_text_readable(x)
  
  x <- str_to_lower(x)
  x <- str_replace_all(x, "https?://\\S+", " ")
  x <- str_replace_all(x, "\\b\\S+@\\S+\\b", " ")
  x <- str_replace_all(x, "[^a-z\\s]", " ")
  x <- str_replace_all(x, "\\s+", " ")
  str_squish(x)
}

canon_for_dedup <- function(x) {
  if (is.na(x)) return(NA_character_)
  x |>
    str_to_lower() |>
    str_replace_all("[0-9]+", "0") |>
    str_replace_all("\\s+", " ") |>
    str_squish()
}


